<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDF7FF"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textFormTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/new_expense"
            android:textColor="#1F1F1F"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/amount"
            android:textColor="#333333"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/amount_hint"
            android:inputType="numberDecimal"
            android:textColor="#1F1F1F"
            android:textColorHint="#888888" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/category"
            android:textColor="#333333"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerCategory"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/description"
            android:textColor="#333333"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/description_hint"
            android:inputType="textCapSentences"
            android:textColor="#1F1F1F"
            android:textColorHint="#888888"
            tools:text="Almuerzo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSelectReceipt"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:text="@string/add_receipt"
            android:textAllCaps="false"
            android:textColor="#0B6B2B"
            android:textStyle="bold"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_receipt"
            app:iconGravity="textStart"
            app:iconTint="#0B6B2B"
            app:strokeColor="#0B6B2B"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSuggestFromReceipt"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="@string/suggest_from_receipt"
            android:textAllCaps="false"
            android:textColor="#0B6B2B"
            android:textStyle="bold"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_receipt"
            app:iconGravity="textStart"
            app:iconTint="#0B6B2B"
            app:strokeColor="#0B6B2B"
            app:strokeWidth="1dp" />

        <ProgressBar
            android:id="@+id/progressOcr"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:indeterminateTint="#0B6B2B"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/containerReceiptPreview"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imageReceiptPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                tools:src="@drawable/ic_launcher_background" />

            <ImageButton
                android:id="@+id/buttonRemoveReceipt"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/remove_receipt"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#CC000000" />

        </FrameLayout>

        <TextView
            android:id="@+id/textError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#B00020"
            android:visibility="gone"
            tools:text="Completá todos los campos" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:indeterminateTint="#0B6B2B"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonUseCurrentLocation"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:text="@string/use_location"
            android:textAllCaps="false"
            android:textColor="#0B6B2B"
            android:textStyle="bold"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_location_add"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="#0B6B2B"
            app:strokeColor="#0B6B2B"
            app:strokeWidth="1dp" />

        <ProgressBar
            android:id="@+id/progressLocation"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:indeterminateTint="#0B6B2B"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textSelectedLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/no_location"
            android:textColor="#666666"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSave"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="32dp"
            android:text="@string/save"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="#0B6B2B"
            app:cornerRadius="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonCancel"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="@string/cancel"
            android:textAllCaps="false"
            android:textColor="#0B6B2B"
            android:textStyle="bold"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="24dp"
            app:strokeColor="#0B6B2B"
            app:strokeWidth="1dp" />

    </LinearLayout>

</ScrollView>